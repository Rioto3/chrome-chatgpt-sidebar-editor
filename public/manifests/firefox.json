{
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "alarms"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "AIチャットエディタ＋ for マイGPT",
    "default_icon": {
      "16": "icon-16x16.png",
      "32": "icon-32x32.png",
      "48": "icon-48x48.png",
      "128": "icon-128x128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aichat-editor-plus@tubeclip.work",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  }
}